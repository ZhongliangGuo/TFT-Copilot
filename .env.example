# Copy this file to .env and fill in your key(s). .env is loaded automatically
# on startup (backend/app.py); existing environment variables always win.

DEEPSEEK_API_KEY=sk-xxxx
# ANTHROPIC_API_KEY=sk-ant-xxxx   # optional: enables Claude
# LLM_PROVIDER=deepseek           # default provider: deepseek | claude
# VISION_API_KEY=xxx              # optional: require this key on the vision service's API
